{
  "name": "preferred-ip-subscription",
  "account_id": "00000000000000000000000000000000",
  "main": "worker.js",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "vars": {
    "CF_DOMAIN": "panel.rex-custom.invalid",
    "TUNNEL_DOMAIN": "sub.rex-custom.invalid",
    "EMBY_SUB_DOMAIN": "sub.rex-custom.invalid",
    "yx": "",
    "p": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rex-emby-subscription-db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "routes": [
    {
      "pattern": "sub.rex-custom.invalid",
      "custom_domain": true
    }
  ]
}
